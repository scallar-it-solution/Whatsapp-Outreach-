# Application
APP_PORT=3000
NODE_ENV=development

# Safety - MUST be explicitly set to true to allow any sends
SEND_ENABLED=false

# Redis
REDIS_URL=redis://localhost:6379

# Database
DB_CLIENT=sqlite
SQLITE_PATH=./data/outreach.db
DATABASE_URL=

# Evolution API
EVOLUTION_BASE_URL=https://evo.deepesh.rest
EVOLUTION_API_KEY=your_key_here

# Senders - comma-separated instance names to auto-register on startup
ACTIVE_SENDERS=sender1,sender2

# Dispatch timing
DEFAULT_DELAY_MIN_SECONDS=45
DEFAULT_DELAY_MAX_SECONDS=90
DAILY_LIMIT_PER_SENDER=80

# Sender quarantine thresholds
QUARANTINE_FAILURE_THRESHOLD=5
QUARANTINE_WINDOW_MINUTES=30

# Webhooks
WEBHOOK_PUBLIC_URL=https://reach.example.com/webhook/evolution

# Dashboard auth
ADMIN_TOKEN=change_this_token

# Quiet hours per country (24h format)
QUIET_HOURS_START=22
QUIET_HOURS_END=8

# Test recipient - used by sender:test command only
TEST_RECIPIENT_PHONE=+919999999999

# Optional CRM
CRM_WEBHOOK_URL=
CRM_API_KEY=
