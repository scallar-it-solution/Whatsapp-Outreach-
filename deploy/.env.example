# Application
APP_PORT=3000
NODE_ENV=production

# Safety - MUST be explicitly set to true to allow any sends
SEND_ENABLED=false

# Redis
REDIS_URL=redis://redis:6379

# Database
DB_CLIENT=sqlite
SQLITE_PATH=/app/data/outreach.db
DATABASE_URL=

# Evolution API
EVOLUTION_BASE_URL=https://evo.example.com
EVOLUTION_API_KEY=

# Senders
ACTIVE_SENDERS=

# Dispatch timing
DEFAULT_DELAY_MIN_SECONDS=45
DEFAULT_DELAY_MAX_SECONDS=90
DAILY_LIMIT_PER_SENDER=80

# Sender quarantine thresholds
QUARANTINE_FAILURE_THRESHOLD=5
QUARANTINE_WINDOW_MINUTES=30

# Webhooks
WEBHOOK_PUBLIC_URL=https://reach.example.com/webhook/evolution

# Dashboard auth
ADMIN_TOKEN=

# Quiet hours per country (24h format)
QUIET_HOURS_START=22
QUIET_HOURS_END=8

# Test recipient
TEST_RECIPIENT_PHONE=

# Optional CRM
CRM_WEBHOOK_URL=
CRM_API_KEY=
