<section class="overflow-x-auto rounded-lg border border-slate-800 bg-slate-900">
  <table class="min-w-full divide-y divide-slate-800 text-sm">
    <thead class="bg-slate-900">
      <tr>
        <th class="px-4 py-3 text-left">Instance</th>
        <th class="px-4 py-3 text-left">Status</th>
        <th class="px-4 py-3 text-left">Health</th>
        <th class="px-4 py-3 text-left">Sent today</th>
        <th class="px-4 py-3 text-left">Last check</th>
        <th class="px-4 py-3 text-left">Last error</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-800">
      <% senders.forEach(function(sender) { %>
        <% const pill = sender.health_score >= 70 ? 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30' : sender.health_score >= 40 ? 'bg-yellow-500/15 text-yellow-300 border-yellow-500/30' : 'bg-red-500/15 text-red-300 border-red-500/30'; %>
        <tr>
          <td class="px-4 py-3 font-medium"><%= sender.instance_name %></td>
          <td class="px-4 py-3"><%= sender.status %></td>
          <td class="px-4 py-3"><span class="rounded-full border px-2 py-1 <%= pill %>"><%= sender.health_score %></span></td>
          <td class="px-4 py-3"><%= sender.sent_today %> / <%= sender.daily_limit %></td>
          <td class="px-4 py-3 text-slate-300"><%= sender.last_health_check_at || '-' %></td>
          <td class="px-4 py-3 text-slate-300"><%= sender.last_error || '-' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
