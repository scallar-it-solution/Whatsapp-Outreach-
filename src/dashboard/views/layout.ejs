<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content="30" />
    <title><%= title %> | Scallar Outreach</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  </head>
  <body class="bg-slate-950 text-slate-100">
    <div class="min-h-screen">
      <header class="border-b border-slate-800 bg-slate-900/80">
        <div class="mx-auto flex max-w-7xl flex-col gap-4 px-4 py-4 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h1 class="text-xl font-semibold tracking-normal">Scallar WhatsApp Outreach</h1>
            <p class="text-sm text-slate-400"><%= title %></p>
          </div>
          <nav class="flex flex-wrap gap-2 text-sm">
            <% const links = [['/', 'Overview'], ['/senders', 'Senders'], ['/campaigns', 'Campaigns'], ['/queue', 'Queue'], ['/leads', 'Leads'], ['/replies', 'Replies'], ['/deadletter', 'Dead Letters']]; %>
            <% links.forEach(function(item) { %>
              <a class="rounded-md border border-slate-700 px-3 py-2 text-slate-200 hover:bg-slate-800" href="<%= item[0] %>?token=<%= token %>"><%= item[1] %></a>
            <% }) %>
          </nav>
        </div>
      </header>
      <main class="mx-auto max-w-7xl px-4 py-6">
        <%- include(page + '.ejs') %>
      </main>
    </div>
  </body>
</html>
