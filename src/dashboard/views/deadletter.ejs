<% if (typeof queueError !== 'undefined') { %>
  <div class="mb-4 rounded-lg border border-red-500/30 bg-red-500/10 p-4 text-red-200"><%= queueError %></div>
<% } %>
<section class="overflow-x-auto rounded-lg border border-slate-800 bg-slate-900">
  <table class="min-w-full divide-y divide-slate-800 text-sm">
    <thead>
      <tr>
        <th class="px-4 py-3 text-left">Job</th>
        <th class="px-4 py-3 text-left">Failed at</th>
        <th class="px-4 py-3 text-left">Reason</th>
        <th class="px-4 py-3 text-left">Lead</th>
        <th class="px-4 py-3 text-left">Campaign</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-800">
      <% deadLetters.forEach(function(item) { %>
        <tr>
          <td class="px-4 py-3"><%= item.id %></td>
          <td class="px-4 py-3"><%= item.failedAt %></td>
          <td class="px-4 py-3"><%= item.reason %></td>
          <td class="px-4 py-3"><%= item.leadId %></td>
          <td class="px-4 py-3"><%= item.campaignId %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
