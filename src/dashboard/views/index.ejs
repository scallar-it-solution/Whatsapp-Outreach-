<section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  <div class="rounded-lg border border-slate-800 bg-slate-900 p-4">
    <div class="text-sm text-slate-400">Queue pending</div>
    <div class="mt-2 text-3xl font-semibold"><%= queueCounts.waiting ?? 0 %></div>
  </div>
  <div class="rounded-lg border border-slate-800 bg-slate-900 p-4">
    <div class="text-sm text-slate-400">Sent today</div>
    <div class="mt-2 text-3xl font-semibold"><%= sentToday %></div>
  </div>
  <div class="rounded-lg border border-slate-800 bg-slate-900 p-4">
    <div class="text-sm text-slate-400">Ack rate</div>
    <div class="mt-2 text-3xl font-semibold"><%= ackRate %>%</div>
  </div>
  <div class="rounded-lg border border-slate-800 bg-slate-900 p-4">
    <div class="text-sm text-slate-400">Active senders</div>
    <div class="mt-2 text-3xl font-semibold"><%= activeSenders %></div>
  </div>
</section>
